{
  "database": {
    "name": "AegisOne Database",
    "version": "1.0.0",
    "environment": "development"
  },
  "engine": {
    "type": "SQLite",
    "orm": "SQLAlchemy"
  },
  "tables": [
    "assets",
    "findings"
  ],
  "features": {
    "asset_tracking": true,
    "risk_tracking": true,
    "finding_tracking": true
  }
}
